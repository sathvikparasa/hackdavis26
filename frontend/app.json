{
  "expo": {
    "name": "Anticipate",
    "slug": "anticipate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/anticipate_icon.png",
    "scheme": "anticipate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anticipate.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a2e1a",
        "foregroundImage": "./assets/images/anticipate_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anticipate.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/anticipate_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/anticipate_logo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#1a2e1a",
          "dark": {
            "backgroundColor": "#1a2e1a"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Anticipate to use your camera to report pests."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Anticipate to choose pest photos from your library."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
